{
  "name": "atlas-cabeca-pescoco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Atlas 3D interativo de cabeça e pescoço para estudo de Odontologia; funciona offline.",
  "license": "CC-BY-SA-4.0",
  "repository": "github:pliniou/pescab-cebolao",
  "homepage": "https://pliniou.github.io/pescab-cebolao/",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "pipeline": "node pipeline/01-baixar.mjs && node pipeline/02-indexar.mjs && node pipeline/03a-za-exportar.mjs && node pipeline/03b-za-alinhar.mjs && node pipeline/03c-filtrar.mjs && node pipeline/04-converter.mjs && node pipeline/05-dicionario.mjs && node pipeline/06-verificar.mjs && node pipeline/07-referencias.mjs && node pipeline/08-validar.mjs && vitest run",
    "modelos": "node pipeline/04-converter.mjs",
    "dicionario": "node pipeline/05-dicionario.mjs && vitest run test/integridade.test.js",
    "validar": "node pipeline/07-referencias.mjs && node pipeline/08-validar.mjs",
    "verificar": "node pipeline/06-verificar.mjs",
    "test": "vitest run",
    "cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "lucide": "1.52.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "20.14.5",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
